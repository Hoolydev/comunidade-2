{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node -e \"console.log('Vercel proxy ready')\"",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "https://movimento-hagios.hoolydev.workers.dev/vendas"
    },
    {
      "source": "/:path*",
      "destination": "https://movimento-hagios.hoolydev.workers.dev/:path*"
    }
  ]
}
