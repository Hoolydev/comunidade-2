# Copie para .env.local e preencha. .env.local está no .gitignore.
# Nenhum destes valores pode aparecer em código — tudo é lido via process.env.

# ---------------------------------------------------------------------------
# Clerk — autenticação
# ---------------------------------------------------------------------------
# Dashboard do Clerk > API Keys. A publishable vai para o cliente (por isso o
# prefixo NEXT_PUBLIC_); a secret nunca sai do servidor.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ---------------------------------------------------------------------------
# Stripe — cobrança
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...

# Um price recorrente por plano. O cliente nunca envia o price: ele envia o
# slug ("mensal" | "anual") e o servidor resolve aqui (app/lib/planos.ts).
#
# São os prices do produto prod_V2NIEDOZO1Meh9. Para descobrir os ids e conferir
# se os valores batem com app/lib/planos.ts:  npm run precos
STRIPE_PRICE_MENSAL=price_...
STRIPE_PRICE_ANUAL=price_...

# Compatibilidade: ambientes antigos usavam um price único. Quando presente, é
# aceito como fallback do plano mensal. Pode remover depois de configurar os
# dois prices acima.
# STRIPE_PRICE_ID=price_...

# O segredo do webhook é DIFERENTE em cada ambiente.
#   local     -> o whsec_ impresso por `stripe listen --forward-to localhost:3000/api/stripe/webhook`
#   produção  -> Dashboard da Stripe > Developers > Webhooks > seu endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Base pública usada em success_url, cancel_url e return_url do portal.
# Em produção precisa ser o domínio real, com https e sem barra no fim.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Caixa de suporte mostrada em /pagamento/sucesso quando o webhook demora mais
# de 20s. É o único canal de socorro de quem pagou e ainda não recebeu acesso,
# então precisa ser um endereço que alguém realmente lê.
NEXT_PUBLIC_EMAIL_SUPORTE=suporte@exemplo.com.br
