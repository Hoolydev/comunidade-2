{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "movimento-hagios",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "movimento-hagios",
      "database_id": "0c37c432-bd3e-4a18-85f3-b7cb9daefbff"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "movimento-hagios-arquivos"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuY29tdW5pZGFkZWhhZ2lvcy5jb20uYnIk"
  }
}
